<!-- Wall-bounce feedback, shown briefly after each bounce (see
     UpdateBounceHud), in the bottom-right cluster right above the
     health bar: rating word + exact angle, a 0°..90° scale in 10°
     segments with the 45° target outlined and the hit segment lit,
     and a jump-timing bar. Rating* class on the panel colors it. -->
<Panel id="bounce_panel" class="BouncePanel Hidden">
	<Panel class="BounceHeader">
		<Label class="BounceRating" text="{s:bounce_rating}" />
		<Label class="BounceAngle" text="{s:bounce_angle}°" />
	</Panel>
	<Panel class="BounceAngleScale">
		<Label class="BounceScaleEdge" text="0°" />
		<each loop="i in range(BOUNCE_ANGLE_SEGMENTS)">
		<Panel id="bounce_angle_seg_{{ i }}" class="BounceAngleSegment{{ i === bounceTargetSegment ? ' BounceAngleTarget' : '' }}" /></each>
		<Label class="BounceScaleEdge" text="90°" />
	</Panel>
	<Panel class="BounceJumpRow">
		<Label class="BounceJumpLabel" text="JUMP" />
		<each loop="i in range(BOUNCE_JUMP_SEGMENTS)">
		<Panel id="bounce_jump_seg_{{ i }}" class="BounceJumpSegment" /></each>
	</Panel>
</Panel>
