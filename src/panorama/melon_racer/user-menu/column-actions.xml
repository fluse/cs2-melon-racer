<Panel class="UserMenuActions">
	<Label class="UserMenuColumnTitle" text="ACTIONS" />
	<module href="../../components/action-button.xml" id="usermenu_respawn_button" color="Green" icon="respawn" label="Respawn at Checkpoint" />
	<!-- Only during a free-roaming time trial (script toggles Hidden,
	     see CanRestartTimeTrial). -->
	<Panel id="usermenu_restart_row" class="UserMenuRestartRow Hidden">
		<module href="../../components/action-button.xml" id="usermenu_restart_button" color="Gold" icon="restart" label="Restart Time Trial [R]" />
	</Panel>
	<!-- While a Grand Prix runs that this player isn't in: "Watch Grand
	     Prix", then "Stop Watching" (race/spectate/, script toggles Hidden). -->
	<Panel id="usermenu_watch_row" class="UserMenuRestartRow Hidden">
		<module href="../../components/action-button.xml" id="usermenu_watch_button" color="Gold" icon="spectate" label="{s:watch_label}" />
	</Panel>
	<!-- "Drone Mode": fly a drone through the map, the melon waits frozen
	     (dev/free-look.js); then "Exit Drone Mode". Not while this player
	     is in a Grand Prix (UpdateDroneButtonHud toggles Hidden). -->
	<Panel id="usermenu_drone_row" class="UserMenuRestartRow">
		<module href="../../components/action-button.xml" id="usermenu_drone_button" color="Gold" icon="free-look" label="{s:drone_label}" />
	</Panel>
	<!-- "Exit Race" while signed up for a heat, else "Return to Hub"
	     (UpdateHubButtonHud) — either way just this player leaves. -->
	<module href="../../components/action-button.xml" id="usermenu_hub_button" color="Red" icon="home" label="{s:hub_label}" />
	<!-- Every leaderboard on one page, in place of the columns
	     (usermenu_leaderboards_page below, hud/leaderboards/). -->
	<module href="../../components/action-button.xml" id="usermenu_leaderboards_button" color="Gold" icon="leaderboard" label="Leaderboards" />
	<!-- Pushes the tutorial button down to the column's bottom edge,
	     apart from the buttons above (.UserMenuActionsSpacer). -->
	<Panel class="UserMenuActionsSpacer" hittest="false" />
	<!-- Same as the hub button (also leaves a running heat), but to
	     intro_spawn — see SendKartToTutorial. -->
	<module href="../../components/action-button.xml" id="usermenu_tutorial_button" color="Plain" icon="tutorial" label="Play Tutorial" />
</Panel>
