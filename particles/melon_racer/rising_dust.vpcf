<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	_class = "CParticleSystemDefinition"
	m_nBehaviorVersion = 12
	// Rising dust: single small, square, white specks drifting slowly
	// upward from a flat disc around the system's origin (not smoke puffs —
	// a wispy smoke texture read as smoke). Self-lit + additive so they
	// stay visible; steady brightness, no twinkle (decided).
	// Square = the addon's own materials/melon_racer/particle_square.vtex
	// (16x16 white PNG with a 1px transparent edge).
	// Not script-driven — place an info_particle_system in Hammer with
	// "Start Active" on, at floor level (e.g. the bottom of a lift shaft).
	// Tuning: emit rate = amount, lifetime x upward speed (+ gravity) =
	// how high it rises, sphere radius = size of the area it rises from.
	m_nMaxParticles = 270
	m_flConstantRadius = 0.25
	// Pre-warm: the system is simulated this many seconds ahead when it
	// starts, so the whole column is already filled instead of taking a
	// full particle lifetime (40-60 s) to build up from the floor.
	m_flPreSimulationTime = 50.0
	m_ConstantColor = [ 255, 255, 255, 255 ]
	m_flMaxDrawDistance = 5000.0
	m_Renderers =
	[
		{
			_class = "C_OP_RenderSprites"
			m_flDiffuseAmount = 0.0
			m_flSelfIllumAmount = 1.0
			m_hTexture = resource:"materials/melon_racer/particle_square.vtex"
			m_bAdditive = true
		},
	]
	m_Operators =
	[
		{
			_class = "C_OP_Decay"
		},
		{
			_class = "C_OP_BasicMovement"
			// slight upward pull, so the specks keep rising instead of stalling
			m_Gravity = [ 0.0, 0.0, 0.5 ]
			m_fDrag = 0.02
		},
		{
			// Short fades only, at the very start/end: a long fade on these
			// tiny additive specks reads as them shrinking. Size itself never
			// changes over a particle's life (no radius operator, decided).
			_class = "C_OP_FadeAndKill"
			m_flEndFadeInTime = 0.03
			m_flStartFadeOutTime = 0.94
			m_flEndFadeOutTime = 1.0
		},
	]
	m_Initializers =
	[
		// spawn area: a flat disc (z bias 0) around the origin
		{
			_class = "C_INIT_CreateWithinSphereTransform"
			m_fRadiusMin = 0.0
			m_fRadiusMax = 160.0
			m_vecDistanceBias = [ 1.0, 1.0, 0.0 ]
		},
		// lifetime (s)
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 40.0
				m_flRandomMax = 60.0
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 1
		},
		// radius
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 0.15
				m_flRandomMax = 0.35
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
		},
		// alpha
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 0.4
				m_flRandomMax = 0.8
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 7
		},
		{
			_class = "C_INIT_RandomColor"
			m_ColorMin = [ 255, 255, 255, 255 ]
			m_ColorMax = [ 255, 255, 255, 255 ]
		},
		// upward speed (z) + a little sideways drift (x/y), units/sec
		{
			_class = "C_INIT_InitialVelocityNoise"
			m_vecOutputMin = [ -2.0, -2.0, 5.0 ]
			m_vecOutputMax = [ 2.0, 2.0, 10.0 ]
			m_flNoiseScale = 1.0
		},
	]
	m_Emitters =
	[
		{
			_class = "C_OP_ContinuousEmitter"
			// A plain number here — the { m_nType ... } form compiles to 0.
			// ~ m_nMaxParticles / average lifetime, so the cap isn't hit
			// (a full cap stalls emission and leaves gaps in the column)
			m_flEmitRate = 5.0
		},
	]
}
