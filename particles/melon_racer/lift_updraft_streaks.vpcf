<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	_class = "CParticleSystemDefinition"
	m_nBehaviorVersion = 12
	// Lift updraft, part 2 of 2: thin, glowing cyan streaks of air drifting up
	// the shaft, a bit faster than the motes of lift_updraft.vpcf — shows the
	// upward wind. Trails stretched along their velocity (C_OP_RenderTrails),
	// soft glow texture so they have no hard ends. Own info_particle_system
	// next to lift_updraft ("Start Active"), not a child of it.
	// Tuning: rise speed x lifetime = how high they reach (~6.75 s x ~32 u/s
	// ≈ 220 units), min = max length = streak length, emit rate = how many.
	m_nMaxParticles = 70
	m_flConstantRadius = 1.0
	m_flPreSimulationTime = 9.0
	m_ConstantColor = [ 255, 255, 255, 255 ]
	m_flMaxDrawDistance = 5000.0
	m_Renderers =
	[
		{
			_class = "C_OP_RenderTrails"
			m_flDiffuseAmount = 0.0
			m_flSelfIllumAmount = 1.0
			m_hTexture = resource:"materials/effects/glows/simple_glow_001.vtex"
			m_bAdditive = true
			// Fixed length (min = max): the length would otherwise follow the
			// speed, and this slow they came out as short, squashed-looking
			// blobs clamped to the minimum instead of thin streaks.
			m_flMaxLength = 35.0
			m_flMinLength = 35.0
			m_flLengthFadeInTime = 0.2
		},
	]
	m_Operators =
	[
		{
			_class = "C_OP_Decay"
		},
		{
			_class = "C_OP_BasicMovement"
		},
		{
			_class = "C_OP_FadeAndKill"
			m_flEndFadeInTime = 0.25
			m_flStartFadeOutTime = 0.55
			m_flEndFadeOutTime = 1.0
		},
	]
	m_Initializers =
	[
		{
			_class = "C_INIT_CreateWithinSphereTransform"
			m_fRadiusMin = 0.0
			m_fRadiusMax = 32.0
			m_vecDistanceBias = [ 1.0, 1.0, 0.0 ]
		},
		// lifetime (s)
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 5.25
				m_flRandomMax = 8.25
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 1
		},
		// radius = streak width
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 0.5
				m_flRandomMax = 0.9
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
		},
		// alpha
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 0.3
				m_flRandomMax = 0.6
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 7
		},
		// glowing cyan, like the holo frames in the map
		{
			_class = "C_INIT_RandomColor"
			m_ColorMin = [ 60, 230, 240, 255 ]
			m_ColorMax = [ 120, 245, 255, 255 ]
		},
		// straight up, units/sec — no sideways part: at this low speed even
		// a little of it tilts each streak visibly askew
		{
			_class = "C_INIT_InitialVelocityNoise"
			m_vecOutputMin = [ 0.0, 0.0, 25.0 ]
			m_vecOutputMax = [ 0.0, 0.0, 40.0 ]
			m_flNoiseScale = 1.0
		},
	]
	m_Emitters =
	[
		{
			_class = "C_OP_ContinuousEmitter"
			// A plain number here — the { m_nType ... } form compiles to 0.
			m_flEmitRate = 7.0
		},
	]
}
