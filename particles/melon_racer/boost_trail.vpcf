<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	_class = "CParticleSystemDefinition"
	m_nBehaviorVersion = 12
	// Boost trail: a glowing band behind a melon going faster than MAX_SPEED
	// (started/stopped by src/melon_drive/boost-trail.js). Continuous soft
	// glow sprites left behind in world space — overlapping, they read as a
	// band — white-yellow at the melon, fading to orange and shrinking
	// behind it. The juice droplets (boost_trail_juice.vpcf) are their own
	// info_particle_system in the same point_template, not a child system —
	// as a child they never showed in-game.
	m_nMaxParticles = 160
	m_flConstantRadius = 8.5
	m_ConstantColor = [ 255, 240, 170, 255 ]
	m_flMaxDrawDistance = 6000.0
	m_Renderers =
	[
		{
			_class = "C_OP_RenderSprites"
			m_flDiffuseAmount = 0.0
			m_flSelfIllumAmount = 1.0
			// Source (editor) format, not what resourceinfo dumps from a
			// compiled .vpcf_c: the compiler turns these two into
			// m_vecTexturesInput / m_nOutputBlendMode itself and drops those
			// if written directly.
			m_hTexture = resource:"materials/effects/glows/simple_glow_001.vtex"
			m_bAdditive = true
		},
	]
	m_Operators =
	[
		{
			_class = "C_OP_Decay"
		},
		{
			_class = "C_OP_BasicMovement"
			m_fDrag = 0.1
		},
		{
			_class = "C_OP_InterpolateRadius"
			m_flStartScale = 1.0
			m_flEndScale = 0.15
		},
		{
			_class = "C_OP_ColorInterpolate"
			m_ColorFade = [ 255, 110, 20, 255 ]
			m_flFadeEndTime = 0.7
		},
		{
			_class = "C_OP_FadeAndKill"
			m_flStartFadeOutTime = 0.3
			m_flEndFadeOutTime = 1.0
			m_flEndFadeInTime = 0.0
		},
	]
	m_Initializers =
	[
		{
			_class = "C_INIT_CreateWithinSphereTransform"
			m_fRadiusMin = 0.0
			m_fRadiusMax = 1.2
		},
		// lifetime (s)
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 0.3
				m_flRandomMax = 0.45
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 1
		},
		// radius
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 7.0
				m_flRandomMax = 10.0
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
		},
		// alpha
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 0.6
				m_flRandomMax = 0.9
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 7
		},
		{
			_class = "C_INIT_RandomColor"
			m_ColorMin = [ 255, 255, 230, 255 ]
			m_ColorMax = [ 255, 215, 110, 255 ]
		},
	]
	m_Emitters =
	[
		{
			_class = "C_OP_ContinuousEmitter"
			// A plain number here — the { m_nType ... } form compiles to 0.
			m_flEmitRate = 180.0
		},
	]
}
