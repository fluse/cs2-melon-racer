<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	_class = "CParticleSystemDefinition"
	m_nBehaviorVersion = 12
	// Jump pad, part 1 of 2: glowing lime rings lying flat (world-Z aligned),
	// one after another shooting up off the pad, widening and fading as they
	// rise — "you go up from here". Part 2 is jump_pad_sparks.vpcf (fast
	// rising sparks); place both as their own info_particle_system, not as
	// parent/child (children never showed in-game, see boost_trail.vpcf).
	// Not script-driven — place in Hammer with "Start Active" on, at the
	// center of the pad, just above its surface.
	// Tuning: emit rate = rings per second, rise speed x lifetime = how high
	// they get (~5 s x ~15 u/s ≈ 75 units); emit rate x lifetime = rings
	// on screen at once (~4); rise speed / emit rate = gap between rings
	// (~19 units). No drag: slowing down made them bunch up at the top., radius = pad size.
	m_nMaxParticles = 8
	m_flConstantRadius = 24.0
	m_flPreSimulationTime = 6.0
	m_ConstantColor = [ 255, 255, 255, 255 ]
	m_flMaxDrawDistance = 5000.0
	m_Renderers =
	[
		{
			_class = "C_OP_RenderSprites"
			m_nOrientationType = "PARTICLE_ORIENTATION_WORLD_Z_ALIGNED"
			m_flDiffuseAmount = 0.0
			m_flSelfIllumAmount = 1.0
			m_hTexture = resource:"materials/particle/particle_ring_wave.vtex"
			m_bAdditive = true
		},
	]
	m_Operators =
	[
		{
			_class = "C_OP_Decay"
		},
		{
			_class = "C_OP_BasicMovement"
		},
		// widens from the pad's size outward as it rises
		{
			_class = "C_OP_InterpolateRadius"
			m_flStartScale = 1.0
			m_flEndScale = 1.3
		},
		{
			_class = "C_OP_FadeAndKill"
			m_flEndFadeInTime = 0.1
			m_flStartFadeOutTime = 0.4
			m_flEndFadeOutTime = 1.0
		},
	]
	m_Initializers =
	[
		{
			_class = "C_INIT_CreateWithinSphereTransform"
			m_fRadiusMin = 0.0
			m_fRadiusMax = 0.0
		},
		// lifetime (s)
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 4.9
				m_flRandomMax = 5.1
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 1
		},
		// alpha
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 0.7
				m_flRandomMax = 0.9
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 7
		},
		// glowing lime green — melon colored, unlike the cyan lift updraft
		{
			_class = "C_INIT_RandomColor"
			m_ColorMin = [ 150, 255, 60, 255 ]
			m_ColorMax = [ 200, 255, 110, 255 ]
		},
		// straight up, units/sec
		{
			_class = "C_INIT_InitialVelocityNoise"
			m_vecOutputMin = [ 0.0, 0.0, 14.0 ]
			m_vecOutputMax = [ 0.0, 0.0, 16.0 ]
			m_flNoiseScale = 1.0
		},
	]
	m_Emitters =
	[
		{
			_class = "C_OP_ContinuousEmitter"
			// A plain number here — the { m_nType ... } form compiles to 0.
			m_flEmitRate = 0.8
		},
	]
}
