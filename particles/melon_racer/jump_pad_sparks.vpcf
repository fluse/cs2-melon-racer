<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	_class = "CParticleSystemDefinition"
	m_nBehaviorVersion = 12
	// Jump pad, part 2 of 2: bright lime sparks shooting fast straight up off
	// the pad and falling behind — the launch power. Trails stretched along
	// their velocity (C_OP_RenderTrails), soft glow texture. Own
	// info_particle_system next to jump_pad_rings ("Start Active"), not a
	// child of it.
	// Tuning: emit rate = how many, velocity x lifetime = how high
	// (~1.35 s, ~85 u/s slowing under gravity ≈ 100 units), sphere radius =
	// pad size.
	m_nMaxParticles = 60
	m_flConstantRadius = 1.0
	m_flPreSimulationTime = 4.0
	m_ConstantColor = [ 255, 255, 255, 255 ]
	m_flMaxDrawDistance = 5000.0
	m_Renderers =
	[
		{
			_class = "C_OP_RenderTrails"
			m_flDiffuseAmount = 0.0
			m_flSelfIllumAmount = 1.0
			m_hTexture = resource:"materials/effects/glows/simple_glow_001.vtex"
			// Not additive (decided): additive lime on a bright scene washed out
			// to a faint, see-through shimmer. Alpha-blended it stays solid
			// and saturated over any background (the texture has alpha, DXT5).
			m_bAdditive = false
			m_flMaxLength = 18.0
			m_flMinLength = 8.0
			m_flLengthFadeInTime = 0.1
		},
	]
	m_Operators =
	[
		{
			_class = "C_OP_Decay"
		},
		{
			_class = "C_OP_BasicMovement"
			m_Gravity = [ 0.0, 0.0, -15.0 ]
		},
		{
			_class = "C_OP_FadeAndKill"
			m_flEndFadeInTime = 0.05
			m_flStartFadeOutTime = 0.5
			m_flEndFadeOutTime = 1.0
		},
	]
	m_Initializers =
	[
		{
			_class = "C_INIT_CreateWithinSphereTransform"
			m_fRadiusMin = 0.0
			m_fRadiusMax = 22.0
			m_vecDistanceBias = [ 1.0, 1.0, 0.0 ]
		},
		// lifetime (s)
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 1.1
				m_flRandomMax = 1.6
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 1
		},
		// radius = spark width
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 1.4
				m_flRandomMax = 2.2
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
		},
		// alpha
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 1.0
				m_flRandomMax = 1.0
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 7
		},
		// strong lime to yellow-lime, the rings' color
		{
			_class = "C_INIT_RandomColor"
			m_ColorMin = [ 90, 230, 20, 255 ]
			m_ColorMax = [ 200, 255, 60, 255 ]
		},
		// fast, mostly straight up, a little spread
		{
			_class = "C_INIT_InitialVelocityNoise"
			m_vecOutputMin = [ -5.0, -5.0, 70.0 ]
			m_vecOutputMax = [ 5.0, 5.0, 100.0 ]
			m_flNoiseScale = 1.0
		},
	]
	m_Emitters =
	[
		{
			_class = "C_OP_ContinuousEmitter"
			// A plain number here — the { m_nType ... } form compiles to 0.
			m_flEmitRate = 9.0
		},
	]
}
