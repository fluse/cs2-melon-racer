<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	_class = "CParticleSystemDefinition"
	m_nBehaviorVersion = 12
	// Played next to boost_trail.vpcf — its own info_particle_system in
	// particle_boost_trail_template (as a child system it never showed): a few melon-juice droplets flung off the
	// boosted melon, falling under gravity and fading. Self-lit and several
	// units big on purpose: at 1-3 units, lit by the scene, they were
	// invisible from the chase camera.
	m_nMaxParticles = 64
	m_flConstantRadius = 4.0
	m_ConstantColor = [ 235, 60, 80, 255 ]
	m_flMaxDrawDistance = 4000.0
	m_Renderers =
	[
		{
			_class = "C_OP_RenderSprites"
			m_flDiffuseAmount = 0.0
			m_flSelfIllumAmount = 1.0
			// Source (editor) format — see boost_trail.vpcf. The same glow
			// texture + additive as the trail band, which shows in-game;
			// materials/particle/water_drop.vtex as a plain sprite didn't.
			m_hTexture = resource:"materials/effects/glows/simple_glow_001.vtex"
			m_bAdditive = true
		},
	]
	m_Operators =
	[
		{
			_class = "C_OP_Decay"
		},
		{
			_class = "C_OP_BasicMovement"
			m_Gravity = [ 0.0, 0.0, -800.0 ]
			m_fDrag = 0.02
		},
		{
			_class = "C_OP_FadeAndKill"
			m_flStartFadeOutTime = 0.6
			m_flEndFadeOutTime = 1.0
			m_flEndFadeInTime = 0.0
		},
	]
	m_Initializers =
	[
		{
			_class = "C_INIT_CreateWithinSphereTransform"
			m_fRadiusMin = 1.2
			m_fRadiusMax = 3.6
		},
		// lifetime (s)
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 0.45
				m_flRandomMax = 0.75
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 1
		},
		// radius
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 3.0
				m_flRandomMax = 5.0
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
		},
		{
			_class = "C_INIT_RandomColor"
			m_ColorMin = [ 210, 30, 55, 255 ]
			m_ColorMax = [ 255, 95, 115, 255 ]
		},
		{
			_class = "C_INIT_InitialVelocityNoise"
			m_vecOutputMin = [ -45.0, -45.0, 20.0 ]
			m_vecOutputMax = [ 45.0, 45.0, 70.0 ]
			m_flNoiseScale = 2.0
		},
	]
	m_Emitters =
	[
		{
			_class = "C_OP_ContinuousEmitter"
			m_flEmitRate = 40.0
		},
	]
}
