<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	_class = "CParticleSystemDefinition"
	m_nBehaviorVersion = 12
	// Lift updraft, part 1 of 2: soft, glowing motes (pale white-mint)
	// floating up through a lift shaft, swaying gently from side to side,
	// slowly growing and fading as they rise — "lightness", the air itself
	// carrying things up. Part 2 is lift_updraft_streaks.vpcf (thin rising
	// air streaks); place both as their own info_particle_system, not as
	// parent/child (children never showed in-game, see boost_trail.vpcf).
	// Not script-driven — place in Hammer with "Start Active" on, at the
	// bottom of the shaft, centered between the walls.
	// Tuning: disc radius = shaft width, lifetime x rise speed (+ gravity)
	// = how high it reaches (~4 s x ~20 u/s ≈ 100 units here).
	m_nMaxParticles = 160
	m_flConstantRadius = 4.0
	// Pre-warm: the column is already full when the map loads.
	m_flPreSimulationTime = 10.0
	m_ConstantColor = [ 255, 255, 255, 255 ]
	m_flMaxDrawDistance = 5000.0
	m_Renderers =
	[
		{
			_class = "C_OP_RenderSprites"
			m_flDiffuseAmount = 0.0
			m_flSelfIllumAmount = 1.0
			m_hTexture = resource:"materials/effects/glows/simple_glow_001.vtex"
			m_bAdditive = true
		},
	]
	m_Operators =
	[
		{
			_class = "C_OP_Decay"
		},
		{
			_class = "C_OP_BasicMovement"
			// gentle upward pull: the motes speed up a little as they rise
			m_Gravity = [ 0.0, 0.0, 3.0 ]
			m_fDrag = 0.04
		},
		{
			// side-to-side sway (position, x/y only), each mote its own rhythm
			_class = "C_OP_OscillateVector"
			m_nField = 0
			m_RateMin = [ -8.0, -8.0, 0.0 ]
			m_RateMax = [ 8.0, 8.0, 0.0 ]
			m_FrequencyMin = [ 0.25, 0.25, 1.0 ]
			m_FrequencyMax = [ 0.7, 0.7, 1.0 ]
		},
		{
			// grow while rising: they "open up" into the air
			_class = "C_OP_InterpolateRadius"
			m_flStartScale = 0.6
			m_flEndScale = 1.5
		},
		{
			// soft glows, so long fades are fine here (unlike rising_dust)
			_class = "C_OP_FadeAndKill"
			m_flEndFadeInTime = 0.2
			m_flStartFadeOutTime = 0.6
			m_flEndFadeOutTime = 1.0
		},
	]
	m_Initializers =
	[
		// spawn area: a flat disc (z bias 0) around the origin
		{
			_class = "C_INIT_CreateWithinSphereTransform"
			m_fRadiusMin = 0.0
			m_fRadiusMax = 35.0
			m_vecDistanceBias = [ 1.0, 1.0, 0.0 ]
		},
		// lifetime (s)
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 3.0
				m_flRandomMax = 5.0
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 1
		},
		// radius
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 2.5
				m_flRandomMax = 6.0
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
		},
		// alpha
		{
			_class = "C_INIT_InitFloat"
			m_InputValue =
			{
				m_nType = "PF_TYPE_RANDOM_UNIFORM"
				m_flRandomMin = 0.25
				m_flRandomMax = 0.6
				m_nRandomMode = "PF_RANDOM_MODE_CONSTANT"
			}
			m_nOutputField = 7
		},
		{
			_class = "C_INIT_RandomColor"
			m_ColorMin = [ 255, 255, 255, 255 ]
			m_ColorMax = [ 190, 255, 215, 255 ]
		},
		// rise speed (z) + a little sideways drift (x/y), units/sec
		{
			_class = "C_INIT_InitialVelocityNoise"
			m_vecOutputMin = [ -4.0, -4.0, 12.0 ]
			m_vecOutputMax = [ 4.0, 4.0, 22.0 ]
			m_flNoiseScale = 1.0
		},
	]
	m_Emitters =
	[
		{
			_class = "C_OP_ContinuousEmitter"
			// A plain number here — the { m_nType ... } form compiles to 0.
			// ~ m_nMaxParticles / average lifetime, so the cap isn't hit
			m_flEmitRate = 5.0
		},
	]
}
