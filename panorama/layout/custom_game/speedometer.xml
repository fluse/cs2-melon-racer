<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/speedometer.css" />
	</styles>

	<Panel class="Root">
		<Panel id="checkpoint_panel" class="CheckpointPanel Hidden">
			<Label class="CheckpointLabel" text="CHECKPOINT" />
			<Panel class="CheckpointRow">
				<Label id="checkpoint_current" class="CheckpointCurrent" text="{s:current}" />
				<Label class="CheckpointSlash" text="/" />
				<Label id="checkpoint_total" class="CheckpointTotal" text="{s:total}" />
			</Panel>
			<Panel class="CheckpointRow">
				<Label id="lap_current" class="LapCurrent" text="{s:lap_current}" />
				<Label class="LapSlash" text="/" />
				<Label id="lap_total" class="LapTotal" text="{s:lap_total}" />
				<Label class="LapUnit" text="LAP" />
			</Panel>
		</Panel>

		<!-- Hub "start the race" prompt: shown while a kart is standing in
		     hub_start_trigger. Toggled between the button (phase HUB) and a
		     waiting message (any other phase) via the WaitingForOthers class.
		     While a heat is running, the moderator (IsModerator class) sees
		     an abort button instead of the plain waiting message. -->
		<Panel id="hub_modal" class="HubModal Hidden">
			<Button id="hub_close_button" class="HubCloseButton">
				<Label class="HubCloseIcon" text="✕" />
			</Button>
			<Label class="HubTitle" text="Ready for racing?" />
			<Button id="hub_start_button" class="HubStartButton">
				<Label text="Start race" />
			</Button>
			<Label class="HubWaitingLabel" text="Rennen läuft bereits…" />
			<Button id="hub_abort_button" class="HubAbortButton">
				<Label text="Cancel race" />
			</Button>
		</Panel>

		<!-- Big centered countdown, only visible to racers during COUNTDOWN.
		     All four images sit stacked in the panel; the Show3/Show2/Show1/
		     ShowGo class on the panel picks which one is visible. -->
		<Panel id="countdown_panel" class="CountdownPanel Hidden">
			<Image class="CountdownImage Countdown3" src="file://{images}/custom_game/number-3.png" />
			<Image class="CountdownImage Countdown2" src="file://{images}/custom_game/number-2.png" />
			<Image class="CountdownImage Countdown1" src="file://{images}/custom_game/number-1.png" />
			<Image class="CountdownImage CountdownGo" src="file://{images}/custom_game/word-go.png" />
		</Panel>

		<!-- Break banner between heats ("Finish!" + next-track countdown). -->
		<Label id="break_label" class="BreakLabel Hidden" text="{s:break}" />

		<!-- Wall-bounce feedback, shown briefly after each bounce (see
		     UpdateBounceHud): rating word + exact angle, a 0°..90° scale in
		     10° segments with the 45° target outlined and the hit segment
		     lit, and a jump-timing bar. Rating* class on the panel colors it. -->
		<Panel id="bounce_panel" class="BouncePanel Hidden">
			<Label class="BounceRating" text="{s:bounce_rating}" />
			<Label class="BounceAngle" text="{s:bounce_angle}°" />
			<Panel class="BounceAngleScale">
				<Label class="BounceScaleEdge" text="0°" />
				<Panel id="bounce_angle_seg_0" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_1" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_2" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_3" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_4" class="BounceAngleSegment BounceAngleTarget" />
				<Panel id="bounce_angle_seg_5" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_6" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_7" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_8" class="BounceAngleSegment" />
				<Label class="BounceScaleEdge" text="90°" />
			</Panel>
			<Panel class="BounceJumpRow">
				<Label class="BounceJumpLabel" text="JUMP" />
				<Panel id="bounce_jump_seg_0" class="BounceJumpSegment" />
				<Panel id="bounce_jump_seg_1" class="BounceJumpSegment" />
				<Panel id="bounce_jump_seg_2" class="BounceJumpSegment" />
				<Panel id="bounce_jump_seg_3" class="BounceJumpSegment" />
				<Panel id="bounce_jump_seg_4" class="BounceJumpSegment" />
			</Panel>
		</Panel>

		<Panel id="speed_panel" class="SpeedPanel">
			<Label id="speed_value" class="SpeedValue" text="{s:speed}" />
			<Label class="SpeedUnit" text="KM/H" />
		</Panel>

		<!-- Melon health: a row of segments that fill left-to-right with
		     kart.health / MELON_MAX_HEALTH, same segmented-bar look as
		     JumpBar below. Turns yellow/red as the melon gets close to
		     breaking, driven from script via UpdateHealthHud. -->
		<Panel id="health_bar" class="HealthBar">
			<Panel id="health_seg_0" class="HealthSegment" />
			<Panel id="health_seg_1" class="HealthSegment" />
			<Panel id="health_seg_2" class="HealthSegment" />
			<Panel id="health_seg_3" class="HealthSegment" />
			<Panel id="health_seg_4" class="HealthSegment" />
			<Panel id="health_seg_5" class="HealthSegment" />
			<Panel id="health_seg_6" class="HealthSegment" />
			<Panel id="health_seg_7" class="HealthSegment" />
			<Panel id="health_seg_8" class="HealthSegment" />
			<Panel id="health_seg_9" class="HealthSegment" />
			<Panel id="health_seg_10" class="HealthSegment" />
			<Panel id="health_seg_11" class="HealthSegment" />
			<Panel id="health_seg_12" class="HealthSegment" />
			<Panel id="health_seg_13" class="HealthSegment" />
			<Panel id="health_seg_14" class="HealthSegment" />
			<Panel id="health_seg_15" class="HealthSegment" />
			<Panel id="health_seg_16" class="HealthSegment" />
			<Panel id="health_seg_17" class="HealthSegment" />
			<Panel id="health_seg_18" class="HealthSegment" />
			<Panel id="health_seg_19" class="HealthSegment" />
		</Panel>

		<Panel id="jump_bar" class="JumpBar">
			<Panel id="jump_seg_0" class="JumpSegment" />
			<Panel id="jump_seg_1" class="JumpSegment" />
			<Panel id="jump_seg_2" class="JumpSegment" />
			<Panel id="jump_seg_3" class="JumpSegment" />
			<Panel id="jump_seg_4" class="JumpSegment" />
			<Panel id="jump_seg_5" class="JumpSegment" />
			<Panel id="jump_seg_6" class="JumpSegment" />
			<Panel id="jump_seg_7" class="JumpSegment" />
			<Panel id="jump_seg_8" class="JumpSegment" />
			<Panel id="jump_seg_9" class="JumpSegment" />
		</Panel>

		<!-- Press USE to toggle: a general-purpose settings/actions menu, not
		     tied to any single map trigger (see UpdateUserMenu/SetUserMenuOpen
		     and the "usermenu_*" buttonId handling in melon_drive.js). Add more
		     rows/sections here for future options — each is just another
		     labeled control, no restructuring needed. -->
		<Panel id="user_menu" class="UserMenu Hidden">
			<Button id="usermenu_close_button" class="UserMenuCloseButton">
				<Label class="UserMenuCloseIcon" text="✕" />
			</Button>
			<Label class="UserMenuTitle" text="Menu" />

			<Button id="usermenu_respawn_button" class="UserMenuActionButton">
				<Label text="Respawn at last checkpoint" />
			</Button>

			<!-- Self-service, unlike hub_abort_button (moderator-only, ends the
			     heat for everyone): pulls just this player out of the current
			     heat and back to the hub, same as ReturnAllToHub handles for a
			     disconnecting racer. -->
			<Button id="usermenu_hub_button" class="UserMenuActionButton UserMenuActionButtonDanger">
				<Label text="Return to hub" />
			</Button>

			<Label class="UserMenuSectionLabel" text="COLOR" />
			<Panel class="UserMenuColorRow">
				<Button id="usermenu_color_red" class="ColorSwatch ColorSwatchRed" />
				<Button id="usermenu_color_orange" class="ColorSwatch ColorSwatchOrange" />
				<Button id="usermenu_color_yellow" class="ColorSwatch ColorSwatchYellow" />
				<Button id="usermenu_color_green" class="ColorSwatch ColorSwatchGreen" />
				<Button id="usermenu_color_blue" class="ColorSwatch ColorSwatchBlue" />
				<Button id="usermenu_color_purple" class="ColorSwatch ColorSwatchPurple" />
				<Button id="usermenu_color_white" class="ColorSwatch ColorSwatchWhite" />
				<Button id="usermenu_color_black" class="ColorSwatch ColorSwatchBlack" />
			</Panel>

			<!-- "Slider" for third-person camera distance — CustomHudLayout has
			     no native slider/drag widget (see melon_drive.js), so this is a
			     row of clickable notches instead: click one to jump straight to
			     that distance. Filled up to the current step via the "Filled"
			     class, same convention as jump_bar's segments above. -->
			<Label class="UserMenuSectionLabel" text="CAMERA DISTANCE" />
			<Panel id="camdist_slider" class="DistanceSlider">
				<Button id="camdist_seg_0" class="DistanceSegment" />
				<Button id="camdist_seg_1" class="DistanceSegment" />
				<Button id="camdist_seg_2" class="DistanceSegment" />
				<Button id="camdist_seg_3" class="DistanceSegment" />
				<Button id="camdist_seg_4" class="DistanceSegment" />
				<Button id="camdist_seg_5" class="DistanceSegment" />
				<Button id="camdist_seg_6" class="DistanceSegment" />
				<Button id="camdist_seg_7" class="DistanceSegment" />
				<Button id="camdist_seg_8" class="DistanceSegment" />
				<Button id="camdist_seg_9" class="DistanceSegment" />
				<Button id="camdist_seg_10" class="DistanceSegment" />
				<Button id="camdist_seg_11" class="DistanceSegment" />
				<Button id="camdist_seg_12" class="DistanceSegment" />
				<Button id="camdist_seg_13" class="DistanceSegment" />
				<Button id="camdist_seg_14" class="DistanceSegment" />
				<Button id="camdist_seg_15" class="DistanceSegment" />
			</Panel>

			<!-- Same clickable-notches trick as CAMERA DISTANCE above, for how
			     high above the melon the chase camera sits (close to the ground
			     vs. a higher overview angle). -->
			<Label class="UserMenuSectionLabel" text="CAMERA HEIGHT" />
			<Panel id="camheight_slider" class="DistanceSlider">
				<Button id="camheight_seg_0" class="DistanceSegment" />
				<Button id="camheight_seg_1" class="DistanceSegment" />
				<Button id="camheight_seg_2" class="DistanceSegment" />
				<Button id="camheight_seg_3" class="DistanceSegment" />
				<Button id="camheight_seg_4" class="DistanceSegment" />
				<Button id="camheight_seg_5" class="DistanceSegment" />
				<Button id="camheight_seg_6" class="DistanceSegment" />
				<Button id="camheight_seg_7" class="DistanceSegment" />
				<Button id="camheight_seg_8" class="DistanceSegment" />
				<Button id="camheight_seg_9" class="DistanceSegment" />
				<Button id="camheight_seg_10" class="DistanceSegment" />
				<Button id="camheight_seg_11" class="DistanceSegment" />
				<Button id="camheight_seg_12" class="DistanceSegment" />
				<Button id="camheight_seg_13" class="DistanceSegment" />
				<Button id="camheight_seg_14" class="DistanceSegment" />
				<Button id="camheight_seg_15" class="DistanceSegment" />
			</Panel>
		</Panel>
	</Panel>
</root>
