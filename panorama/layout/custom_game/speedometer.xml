<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/speedometer.css" />
	</styles>

	<Panel class="Root">
		<!-- Black fade along the bottom of the screen, behind everything else
		     (first child): 20% at the bottom edge, fading out upward. -->
		<Panel class="BottomFade" hittest="false" />

		<!-- Time trial, top left: the run clock, the player's best on this track,
		     and after the finish the result (see time-trial.js). -->
		<Panel id="run_panel" class="RunPanel Hidden">
			<Label id="run_time" class="RunTime" text="{s:time}" />
			<Panel class="RunBestRow">
				<Label class="RunBestUnit" text="BEST" />
				<Label id="run_best" class="RunBest" text="{s:best}" />
			</Panel>
			<Label id="run_result" class="RunResult Hidden" text="{s:result}" />
		</Panel>

		<!-- Checkpoint strip, top center: start flag, one numbered circle per
		     checkpoint (CHECKPOINT_HUD_SLOTS of them — unused ones get the
		     Unused class, a longer track shows a moving window with "…" at the
		     cut-off ends), finish flag. States: Reached / Next / pending (no
		     class). The lap row only shows on tracks with more than one lap. -->
		<Panel id="checkpoint_panel" class="CheckpointStrip Hidden">
			<Panel class="StripRow">
				<Image id="cp_start" class="StripFlag Reached" src="file://{images}/custom_game/icons/track-start.png" />
				<Label id="cp_more_before" class="StripMore Hidden" text="…" />
				<Panel id="cp_link_0" class="StripLink" />
				<Panel id="cp_slot_0" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_1" class="StripLink" />
				<Panel id="cp_slot_1" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_2" class="StripLink" />
				<Panel id="cp_slot_2" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_3" class="StripLink" />
				<Panel id="cp_slot_3" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_4" class="StripLink" />
				<Panel id="cp_slot_4" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_5" class="StripLink" />
				<Panel id="cp_slot_5" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_6" class="StripLink" />
				<Panel id="cp_slot_6" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_7" class="StripLink" />
				<Panel id="cp_slot_7" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_8" class="StripLink" />
				<Panel id="cp_slot_8" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_9" class="StripLink" />
				<Panel id="cp_slot_9" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_10" class="StripLink" />
				<Panel id="cp_slot_10" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Panel id="cp_link_11" class="StripLink" />
				<Panel id="cp_slot_11" class="StripCheckpoint">
					<Label class="StripNumber" text="{s:n}" />
				</Panel>
				<Label id="cp_more_after" class="StripMore Hidden" text="…" />
				<Panel id="cp_link_finish" class="StripLink" />
				<Image id="cp_finish" class="StripFlag" src="file://{images}/custom_game/icons/track-finish.png" />
			</Panel>
			<Panel id="lap_row" class="StripLapRow">
				<Label class="LapUnit" text="LAP" />
				<Label id="lap_current" class="LapCurrent" text="{s:lap_current}" />
				<Label class="LapSlash" text="/" />
				<Label id="lap_total" class="LapTotal" text="{s:lap_total}" />
			</Panel>
		</Panel>

		<!-- Hub "start the race" prompt: shown while a kart is standing in
		     hub_start_trigger. Toggled between the button (phase HUB) and a
		     waiting message (any other phase) via the WaitingForOthers class.
		     While a heat is running, the moderator (IsModerator class) sees
		     an abort button instead of the plain waiting message. -->
		<Panel id="hub_modal" class="HubModal Hidden">
			<Button id="hub_close_button" class="HubCloseButton">
				<Label class="HubCloseIcon" text="✕" />
			</Button>
			<Label class="HubTitle" text="Ready for racing?" />
			<Button id="hub_start_button" class="HubStartButton">
				<Label text="Start race" />
			</Button>
			<Label class="HubWaitingLabel" text="Race already in progress…" />
			<Button id="hub_abort_button" class="HubAbortButton">
				<Label text="Cancel race" />
			</Button>
		</Panel>

		<!-- Big centered countdown, only visible to racers during COUNTDOWN.
		     All four images sit stacked in the panel; the Show3/Show2/Show1/
		     ShowGo class on the panel picks which one is visible. -->
		<Panel id="countdown_panel" class="CountdownPanel Hidden">
			<Image class="CountdownImage Countdown3" src="file://{images}/custom_game/number-3.png" />
			<Image class="CountdownImage Countdown2" src="file://{images}/custom_game/number-2.png" />
			<Image class="CountdownImage Countdown1" src="file://{images}/custom_game/number-1.png" />
			<Image class="CountdownImage CountdownGo" src="file://{images}/custom_game/word-go.png" />
		</Panel>

		<!-- Shown to a racer the moment they finish (see FinishKart), until
		     the next heat or the hub. -->
		<Image id="finish_image" class="FinishImage Hidden" src="file://{images}/custom_game/word-finish.png" />

		<!-- Countdown under the finish image between heats (BREAK_SECONDS … 0,
		     see race-flow.js): a tens and a ones digit, all ten number images
		     stacked in each; the On class on one image shows it. The tens
		     slot (break_tens) only shows from 10 up, collapsed otherwise so
		     a single digit stays centered. -->
		<Panel id="break_countdown" class="BreakCountdown Hidden" hittest="false">
			<Panel id="break_tens" class="BreakDigit BreakTens">
				<Image id="break_tens_0" class="BreakDigitImage" src="file://{images}/custom_game/number-0.png" />
				<Image id="break_tens_1" class="BreakDigitImage" src="file://{images}/custom_game/number-1.png" />
				<Image id="break_tens_2" class="BreakDigitImage" src="file://{images}/custom_game/number-2.png" />
				<Image id="break_tens_3" class="BreakDigitImage" src="file://{images}/custom_game/number-3.png" />
				<Image id="break_tens_4" class="BreakDigitImage" src="file://{images}/custom_game/number-4.png" />
				<Image id="break_tens_5" class="BreakDigitImage" src="file://{images}/custom_game/number-5.png" />
				<Image id="break_tens_6" class="BreakDigitImage" src="file://{images}/custom_game/number-6.png" />
				<Image id="break_tens_7" class="BreakDigitImage" src="file://{images}/custom_game/number-7.png" />
				<Image id="break_tens_8" class="BreakDigitImage" src="file://{images}/custom_game/number-8.png" />
				<Image id="break_tens_9" class="BreakDigitImage" src="file://{images}/custom_game/number-9.png" />
			</Panel>
			<Panel class="BreakDigit">
				<Image id="break_ones_0" class="BreakDigitImage" src="file://{images}/custom_game/number-0.png" />
				<Image id="break_ones_1" class="BreakDigitImage" src="file://{images}/custom_game/number-1.png" />
				<Image id="break_ones_2" class="BreakDigitImage" src="file://{images}/custom_game/number-2.png" />
				<Image id="break_ones_3" class="BreakDigitImage" src="file://{images}/custom_game/number-3.png" />
				<Image id="break_ones_4" class="BreakDigitImage" src="file://{images}/custom_game/number-4.png" />
				<Image id="break_ones_5" class="BreakDigitImage" src="file://{images}/custom_game/number-5.png" />
				<Image id="break_ones_6" class="BreakDigitImage" src="file://{images}/custom_game/number-6.png" />
				<Image id="break_ones_7" class="BreakDigitImage" src="file://{images}/custom_game/number-7.png" />
				<Image id="break_ones_8" class="BreakDigitImage" src="file://{images}/custom_game/number-8.png" />
				<Image id="break_ones_9" class="BreakDigitImage" src="file://{images}/custom_game/number-9.png" />
			</Panel>
		</Panel>

		<!-- Wall-bounce feedback, shown briefly after each bounce (see
		     UpdateBounceHud), in the bottom-right cluster right above the
		     health bar: rating word + exact angle, a 0°..90° scale in 10°
		     segments with the 45° target outlined and the hit segment lit,
		     and a jump-timing bar. Rating* class on the panel colors it. -->
		<Panel id="bounce_panel" class="BouncePanel Hidden">
			<Panel class="BounceHeader">
				<Label class="BounceRating" text="{s:bounce_rating}" />
				<Label class="BounceAngle" text="{s:bounce_angle}°" />
			</Panel>
			<Panel class="BounceAngleScale">
				<Label class="BounceScaleEdge" text="0°" />
				<Panel id="bounce_angle_seg_0" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_1" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_2" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_3" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_4" class="BounceAngleSegment BounceAngleTarget" />
				<Panel id="bounce_angle_seg_5" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_6" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_7" class="BounceAngleSegment" />
				<Panel id="bounce_angle_seg_8" class="BounceAngleSegment" />
				<Label class="BounceScaleEdge" text="90°" />
			</Panel>
			<Panel class="BounceJumpRow">
				<Label class="BounceJumpLabel" text="JUMP" />
				<Panel id="bounce_jump_seg_0" class="BounceJumpSegment" />
				<Panel id="bounce_jump_seg_1" class="BounceJumpSegment" />
				<Panel id="bounce_jump_seg_2" class="BounceJumpSegment" />
				<Panel id="bounce_jump_seg_3" class="BounceJumpSegment" />
				<Panel id="bounce_jump_seg_4" class="BounceJumpSegment" />
			</Panel>
		</Panel>

		<!-- Speed panel, bottom center: the km/h readout over the health bar —
		     pure CSS, no images: a container that is only a white outline, inside
		     it the fill bar of HEALTH_BAR_SEGMENTS white pieces in a row, emptying
		     right to left — each piece transparent until the script makes it
		     white with an "On" class (UpdateHealthHud) — and the wall-jump dots right of it.
		     Every toggled panel gets exactly one class ("On") and starts without
		     it: several different classes toggled on one panel never showed
		     in-game. Flat on purpose: inside a panel turned with a CSS 3D
		     transform, class changes from script never showed either. -->
		<Panel id="speed_bottom" class="SpeedBottom">
			<Panel class="SpeedRow">
				<!-- as wide as the dots on the right, so the speed panel stays centered -->
				<Panel class="SpeedRowSpacer" />
				<Panel id="speed_panel" class="SpeedPanel">
					<Panel class="SpeedReadout">
						<Label id="speed_value" class="SpeedValue" text="{s:speed}" />
					</Panel>
					<!-- the container is the white outline; inside it the fill bar, emptying right to left -->
					<Panel id="health_bar" class="HealthBar">
						<Panel id="health_fill" class="HealthFill">
							<Panel id="health_seg_0" class="HealthSeg" />
							<Panel id="health_seg_1" class="HealthSeg" />
							<Panel id="health_seg_2" class="HealthSeg" />
							<Panel id="health_seg_3" class="HealthSeg" />
							<Panel id="health_seg_4" class="HealthSeg" />
							<Panel id="health_seg_5" class="HealthSeg" />
							<Panel id="health_seg_6" class="HealthSeg" />
							<Panel id="health_seg_7" class="HealthSeg" />
							<Panel id="health_seg_8" class="HealthSeg" />
							<Panel id="health_seg_9" class="HealthSeg" />
							<Panel id="health_seg_10" class="HealthSeg" />
							<Panel id="health_seg_11" class="HealthSeg" />
							<Panel id="health_seg_12" class="HealthSeg" />
							<Panel id="health_seg_13" class="HealthSeg" />
							<Panel id="health_seg_14" class="HealthSeg" />
							<Panel id="health_seg_15" class="HealthSeg" />
							<Panel id="health_seg_16" class="HealthSeg" />
							<Panel id="health_seg_17" class="HealthSeg" />
							<Panel id="health_seg_18" class="HealthSeg" />
							<Panel id="health_seg_19" class="HealthSeg" />
							<Panel id="health_seg_20" class="HealthSeg" />
							<Panel id="health_seg_21" class="HealthSeg" />
							<Panel id="health_seg_22" class="HealthSeg" />
							<Panel id="health_seg_23" class="HealthSeg" />
							<Panel id="health_seg_24" class="HealthSeg" />
							<Panel id="health_seg_25" class="HealthSeg" />
							<Panel id="health_seg_26" class="HealthSeg" />
							<Panel id="health_seg_27" class="HealthSeg" />
							<Panel id="health_seg_28" class="HealthSeg" />
							<Panel id="health_seg_29" class="HealthSeg" />
						</Panel>
					</Panel>
				</Panel>
				<!-- Wall-jump charges: one dot per WALL_JUMP_CHARGES, stacked bottom
				     up (the last one, dot 0, at the bottom). Each dot is a white outline
				     (JumpDot) with a fill inside (jump_dot_<i>), transparent until the
				     script puts "On" on it once that charge is ready (UpdateJumpHud). -->
				<Panel id="jump_bar" class="JumpDots">
					<Panel class="JumpDot"><Panel id="jump_dot_2" class="JumpDotFill" /></Panel>
					<Panel class="JumpDot"><Panel id="jump_dot_1" class="JumpDotFill" /></Panel>
					<Panel class="JumpDot"><Panel id="jump_dot_0" class="JumpDotFill" /></Panel>
				</Panel>
			</Panel>
		</Panel>

		<!-- Press USE to toggle: a general-purpose settings/actions menu, not
		     tied to any single map trigger (see UpdateUserMenu/SetUserMenuOpen
		     and the "usermenu_*" buttonId handling in index.js). One card per
		     section (UserMenuSection: icon + title, then its controls); add a
		     new option as another card. The logo is last in the wrapper so it
		     draws over the card's top edge; icons come from
		     tools/make-icons.mjs. -->
		<Panel id="user_menu" class="UserMenu Hidden" hittest="false">
			<!-- Full-screen holo scanlines behind the menu (see
			     .UserMenuScanlines): 40 rows x 10 = 400 lines, then the
			     sweeping glow band over them. -->
			<Panel class="UserMenuScanlines" hittest="false">
				<Panel class="UserMenuScanline" hittest="false" /> <Panel class="UserMenuScanline" hittest="false" /> <Panel class="UserMenuScanline" hittest="false" /> <Panel class="UserMenuScanline" hittest="false" /> <Panel class="UserMenuScanline" hittest="false" /> <Panel class="UserMenuScanline" hittest="false" /> <Panel class="UserMenuScanline" hittest="false" /> <Panel class="UserMenuScanline" hittest="false" /> <Panel class="UserMenuScanline" hittest="false" /> <Panel class="UserMenuScanline" hittest="false" />
