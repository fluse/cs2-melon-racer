{
    "name": "melon_racer",
    "version": "0.7.0",
    "private": true,
    "description": "Build tooling for the melon_racer CS2 addon's cs_script sources (src/ -> maps/scripts/) and HUD layout (src/panorama/ -> panorama/layout/).",
    "type": "module",
    "scripts": {
        "build": "node build.mjs",
        "watch": "node build.mjs --watch",
        "test": "node --test \"test/**/*.test.mjs\"",
        "site": "node site/build.mjs"
    },
    "devDependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "clipper-lib": "^6.4.2",
        "earcut": "^3.2.4",
        "opentype.js": "^2.0.0",
        "posthtml": "^0.16.7",
        "posthtml-expressions": "^1.11.4",
        "posthtml-modules": "^0.9.1",
        "rollup": "^4.63.3"
    }
}
